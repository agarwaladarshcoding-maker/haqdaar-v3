   "text": "Reply language = the language Sarvam heard on\nthis turn. Not sure (very few words): keep the\nlast one. A language the voice can not speak:\nreply in Hindi and say so once.",
   "fontSize": 20,
   "fontFamily": 1,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "n_lang",
   "originalText": "Reply language = the language Sarvam heard on this turn. Not sure (very few words): keep the last one. A language the voice can not speak: reply in Hindi and say so once.",
   "lineHeight": 1.25,
   "autoResize": true
  },
