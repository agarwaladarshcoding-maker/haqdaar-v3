  {
   "id": "n_limits",
   "type": "rectangle",
   "x": 610.0,
   "y": 2432.0,
   "width": 420,
   "height": 532.0,
   "angle": 0,
   "strokeColor": "#e8590c",
   "backgroundColor": "#fff4e6",
