   "updated": 1759650000000,
   "link": null,
   "locked": false,
   "text": "MANUAL OPERATOR APPROVAL\nOperator reviews finding, edits say text if\nneeded, and presses Enter (or clicks \"Call\nBack\"). If photo is blurry/unreadable,\npresses B (\"not clear\"). Writes\nnext_call.json.",
   "fontSize": 20,
   "fontFamily": 1,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "n_p_manual_app",
   "originalText": "MANUAL OPERATOR APPROVAL\nOperator reviews finding, edits say text if needed, and presses Enter (or clicks \"Call Back\"). If photo is blurry/unreadable, presses B (\"not clear\"). Writes next_call.json.",
   "lineHeight": 1.25,
   "autoResize": true
  },
