   "boundElements": [],
   "updated": 1759650000000,
   "link": null,
   "locked": false,
   "text": "SMS REASSEMBLY MANAGER\n(reassembler.py)\n- Route POST /sms/inbound on port 8002\n(SMS_DOOR=true)\n- Ingests pieces (sender, text), tracks\nindices, drops duplicates\n- Returns ACK with missing piece list\n- When all pieces arrive (or \"done\"\nmessage / 2 min timeout), reconstructs\nbinary JPEG byte-stream",
   "fontSize": 20,
   "fontFamily": 1,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "n_p_reasm",
   "originalText": "SMS REASSEMBLY MANAGER (reassembler.py)\n- Route POST /sms/inbound on port 8002 (SMS_DOOR=true)\n- Ingests pieces (sender, text), tracks indices, drops duplicates\n- Returns ACK with missing piece list\n- When all pieces arrive (or \"done\" message / 2 min timeout), reconstructs binary JPEG byte-stream",
   "lineHeight": 1.25,
   "autoResize": true
  },
