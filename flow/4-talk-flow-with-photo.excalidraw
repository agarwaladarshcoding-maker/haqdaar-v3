  {
   "id": "t_rag",
   "type": "text",
   "x": -1462.0,
   "y": 1896.0,
   "width": 395.8,
   "height": 225.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
