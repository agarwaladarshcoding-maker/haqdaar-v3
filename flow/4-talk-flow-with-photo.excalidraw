   "boundElements": [],
   "updated": 1759650000000,
   "link": null,
   "locked": false,
   "text": "PHOTO UPLOAD & STATE LOCK\n- Uploads photo files via POST\n/p/<token>/photo\n- Caller taps \"Send\" -> POST\n/p/<token>/done\n- Server validates: max 6 photos, max 5\nMB, image format only\n- State locks to \"reading\" (blocks duplicate\nspends)",
   "fontSize": 20,
   "fontFamily": 1,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "n_p_upload",
   "originalText": "PHOTO UPLOAD & STATE LOCK\n- Uploads photo files via POST /p/<token>/photo\n- Caller taps \"Send\" -> POST /p/<token>/done\n- Server validates: max 6 photos, max 5 MB, image format only\n- State locks to \"reading\" (blocks duplicate spends)",
   "lineHeight": 1.25,
   "autoResize": true
