   "updated": 1759650000000,
   "link": null,
   "locked": false,
   "text": "CASE CREATED & CONTEXT SAVED\n- 10-char secure token (PHOTO_DIR/<token>/)\n- Caller phone number kept in case only (never\nin links/logs/pages, wiped after call-back or\n24h)\n- Records languages spoken so far (up to 4\ncodes)\n- Saves Call 1 ID and answered qualification\nfacts",
   "fontSize": 20,
   "fontFamily": 1,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "n_p_case",
   "originalText": "CASE CREATED & CONTEXT SAVED\n- 10-char secure token (PHOTO_DIR/<token>/)\n- Caller phone number kept in case only (never in links/logs/pages, wiped after call-back or 24h)\n- Records languages spoken so far (up to 4 codes)\n- Saves Call 1 ID and answered qualification facts",
   "lineHeight": 1.25,
   "autoResize": true
  },
