   "link": null,
   "locked": false,
   "text": "CLIENT-SIDE IMAGE SHRINK\n- HTML5 Canvas automatically resizes\nphotos (~1000px, < 5 MB) for fast upload\non 2G/3G\n- Canvas toBlob with toDataURL fallback\n- Memory-safe client compression\nprevents phone browser crash",
   "fontSize": 20,
   "fontFamily": 1,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "n_p_shrink",
   "originalText": "CLIENT-SIDE IMAGE SHRINK\n- HTML5 Canvas automatically resizes photos (~1000px, < 5 MB) for fast upload on 2G/3G\n- Canvas toBlob with toDataURL fallback\n- Memory-safe client compression prevents phone browser crash",
   "lineHeight": 1.25,
   "autoResize": true
  },
