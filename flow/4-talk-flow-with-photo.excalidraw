   "text": "CUT-IN AT THE GREETING, the same\ngate: real words stop the greeting and\nare taken as turn 1. Key 6 stops it and\ngoes to keys.",
   "fontSize": 20,
   "fontFamily": 1,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "n_b_greet",
   "originalText": "CUT-IN AT THE GREETING, the same gate: real words stop the greeting and are taken as turn 1. Key 6 stops it and goes to keys.",
   "lineHeight": 1.25,
   "autoResize": true
  },
