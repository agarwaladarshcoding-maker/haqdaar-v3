   "locked": false,
   "text": "AUTO-APPROVAL (zero human delay)\nSystem automatically approves valid\nfindings. Composes concise 3-sentence\nsay text in caller's language. Writes\nPHOTO_DIR/next_call.json with {token,\nlang, say, made}.",
   "fontSize": 20,
   "fontFamily": 1,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "n_p_auto_app",
   "originalText": "AUTO-APPROVAL (zero human delay)\nSystem automatically approves valid findings. Composes concise 3-sentence say text in caller's language. Writes PHOTO_DIR/next_call.json with {token, lang, say, made}.",
   "lineHeight": 1.25,
   "autoResize": true
  },
