   "boundElements": [],
   "updated": 1759650000000,
   "link": null,
   "locked": false,
   "text": "KEYS THAT WORK ALL THE TIME IN\nKEYS MODE\n# = say it again (twice = slower)\n* = the next language\nCUT-IN BY KEY: a key pressed while a\nlist is read stops the voice at once and is\ntaken. In the first 0.25 s of a new prompt\na key is not counted: it was meant for the\nold prompt.",
   "fontSize": 20,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "n_k_rules",
   "originalText": "KEYS THAT WORK ALL THE TIME IN KEYS MODE\n# = say it again (twice = slower)\n* = the next language\nCUT-IN BY KEY: a key pressed while a list is read stops the voice at once and is taken. In the first 0.25 s of a new prompt a key is not counted: it was meant for the old prompt.",
   "lineHeight": 1.25,
   "autoResize": true
  },
