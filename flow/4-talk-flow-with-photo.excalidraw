   "link": null,
   "locked": false,
   "text": "DOSE GUARD & SAFETY SANITIZATION\n- Strips chemical brand names, medicines, and\ndrug dosages (mg, gm, tablet, \u0917\u094b\u0932\u0940, spray\ndosage)\n- Prevents AI hallucinations or dangerous\nmedical advice\n- Truncates finding text to safe 400-char\nboundary",
   "fontSize": 20,
   "fontFamily": 1,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "n_p_dose",
   "originalText": "DOSE GUARD & SAFETY SANITIZATION\n- Strips chemical brand names, medicines, and drug dosages (mg, gm, tablet, \u0917\u094b\u0932\u0940, spray dosage)\n- Prevents AI hallucinations or dangerous medical advice\n- Truncates finding text to safe 400-char boundary",
   "lineHeight": 1.25,
   "autoResize": true
  },
