   "updated": 1759650000000,
   "link": null,
   "locked": false,
   "text": "UNIFIED CASE STORAGE\nBoth Door 1 and Door 0 add binary JPEG\nphotos via cases.add_photo(token, jpeg_bytes).\n- Stored in PHOTO_DIR/<token>/ on disk\n- Status updates: \"waiting\" -> \"photo\" ->\n\"reading\"\n- Automatic 10-minute sweep cleans cases\npast 24 hours",
   "fontSize": 20,
   "fontFamily": 1,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "n_p_store",
   "originalText": "UNIFIED CASE STORAGE\nBoth Door 1 and Door 0 add binary JPEG photos via cases.add_photo(token, jpeg_bytes).\n- Stored in PHOTO_DIR/<token>/ on disk\n- Status updates: \"waiting\" -> \"photo\" -> \"reading\"\n- Automatic 10-minute sweep cleans cases past 24 hours",
   "lineHeight": 1.25,
   "autoResize": true
  },
