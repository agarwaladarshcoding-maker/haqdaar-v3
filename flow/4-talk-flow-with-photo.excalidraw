   "updated": 1759650000000,
   "link": null,
   "locked": false,
   "text": "ASK ONE THING, with its key list\nFirst the kind of need (farming, health,\npension ...). Then the question picker\nnames the box that cuts the list most:\ngender, social group, age, income, work,\nstate.\n1 to 9 = a choice, 0 = I do not know",
   "fontSize": 20,
   "fontFamily": 1,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "n_k_ask",
   "originalText": "ASK ONE THING, with its key list\nFirst the kind of need (farming, health, pension ...). Then the question picker names the box that cuts the list most: gender, social group, age, income, work, state.\n1 to 9 = a choice, 0 = I do not know",
   "lineHeight": 1.25,
   "autoResize": true
  },
