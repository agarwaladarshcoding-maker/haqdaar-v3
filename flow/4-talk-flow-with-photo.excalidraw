   "link": null,
   "locked": false,
   "text": "MODEL OR VOICE FAILS\nModel: the 2nd key, then the next\nmodel. Voice: one more try. Still\nnothing: a recorded line, \"Sorry,\nplease call again.\"",
   "fontSize": 20,
   "fontFamily": 1,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "n_fail",
   "originalText": "MODEL OR VOICE FAILS\nModel: the 2nd key, then the next model. Voice: one more try. Still nothing: a recorded line, \"Sorry, please call again.\"",
   "lineHeight": 1.25,
   "autoResize": true
  },
