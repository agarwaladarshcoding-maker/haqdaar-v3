   "updated": 1759650000000,
   "link": null,
   "locked": false,
   "text": "DOOR 1: ONLINE MOBILE WEB PAGE\nCaller taps link in SMS -> opens\nhttps://<domain>/p/<token>\n- Served by photo web server on port\n8002 (via tunnel)\n- Standalone HTML page < 20 KB (no\nCDN/external JS)\n- Multi-language UI in caller's spoken\nlanguages (hi/mr/en/gu/ta)\n- Responsive viewport, high-contrast,\nlarge touch targets",
   "fontSize": 20,
   "fontFamily": 1,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "n_p_web",
   "originalText": "DOOR 1: ONLINE MOBILE WEB PAGE\nCaller taps link in SMS -> opens https://<domain>/p/<token>\n- Served by photo web server on port 8002 (via tunnel)\n- Standalone HTML page < 20 KB (no CDN/external JS)\n- Multi-language UI in caller's spoken languages (hi/mr/en/gu/ta)\n- Responsive viewport, high-contrast, large touch targets",
   "lineHeight": 1.25,
   "autoResize": true
  },
