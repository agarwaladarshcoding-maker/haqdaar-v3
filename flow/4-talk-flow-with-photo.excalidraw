   "link": null,
   "locked": false,
   "text": "GREETING, short\nIn Hindi, English, Marathi, Gujarati and Tamil,\neach says: \"Welcome to Haqdaar. Speak in\nEnglish or your own language. For keys, press\n6.\"",
   "fontSize": 20,
   "fontFamily": 1,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "n_greet",
   "originalText": "GREETING, short\nIn Hindi, English, Marathi, Gujarati and Tamil, each says: \"Welcome to Haqdaar. Speak in English or your own language. For keys, press 6.\"",
   "lineHeight": 1.25,
   "autoResize": true
  },
