   "updated": 1759650000000,
   "link": null,
   "locked": false,
   "text": "KEYWORD BITS + QUESTION PICKER\n(fixed code, no model)\nWords like farmer, widow, 60+, a\nstate name set bits. Schemes that do\nnot fit are dropped. Many still fit:\nminimax picks the ONE question whose\nworst answer leaves the fewest\nschemes.",
   "fontSize": 20,
   "fontFamily": 1,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "n_bits",
   "originalText": "KEYWORD BITS + QUESTION PICKER\n(fixed code, no model)\nWords like farmer, widow, 60+, a state name set bits. Schemes that do not fit are dropped. Many still fit: minimax picks the ONE question whose worst answer leaves the fewest schemes.",
   "lineHeight": 1.25,
   "autoResize": true
  },
