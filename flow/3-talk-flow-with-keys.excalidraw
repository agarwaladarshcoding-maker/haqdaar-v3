   "text": "GO ON: says the cut sentence again\nfrom its start, then the rest. No\n\"sorry\". 2 false stops in one reply: the\near is off till that reply ends.",
   "fontSize": 20,
   "fontFamily": 1,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "n_b_resume",
   "originalText": "GO ON: says the cut sentence again from its start, then the rest. No \"sorry\". 2 false stops in one reply: the ear is off till that reply ends.",
   "lineHeight": 1.25,
   "autoResize": true
  },
