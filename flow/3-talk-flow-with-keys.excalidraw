  {
   "id": "t_limits",
   "type": "text",
   "x": 628.0,
   "y": 2423.0,
   "width": 377.8,
   "height": 350.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
