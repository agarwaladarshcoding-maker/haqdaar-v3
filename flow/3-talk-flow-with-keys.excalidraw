  {
   "id": "t_b_rules",
   "type": "text",
   "x": 2128.0,
   "y": 2980.0,
   "width": 395.2,
   "height": 275.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1471609727,
   "version": 1,
   "versionNonce": 1137122203,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1759650000000,
   "link": null,
   "locked": false,
   "text": "CUT-IN RULES\n- the ear is on from the first sound of\neach reply\n- \"one moment\" is never cut\n- in talk mode a key does not stop the\nvoice (6 = keys, chart 3)\n- speakerphone: the agent's own voice\nmust not count as the caller; the\n2-false-stops rule ends it if it does\n- \"say it again\" after a cut-in starts from\nthe cut sentence",
   "fontSize": 20,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "n_b_rules",
   "originalText": "CUT-IN RULES\n- the ear is on from the first sound of each reply\n- \"one moment\" is never cut\n- in talk mode a key does not stop the voice (6 = keys, chart 3)\n- speakerphone: the agent's own voice must not count as the caller; the 2-false-stops rule ends it if it does\n- \"say it again\" after a cut-in starts from the cut sentence",
   "lineHeight": 1.25,
   "autoResize": true
  },
