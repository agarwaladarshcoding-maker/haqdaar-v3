   "text": "LISTEN\nWait for them to speak in their own language.\nSarvam finds the language by itself, on every\nturn. It can be mixed, and it can be a language\noutside the greeting.",
   "fontSize": 20,
   "fontFamily": 1,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "n_listen",
   "originalText": "LISTEN\nWait for them to speak in their own language. Sarvam finds the language by itself, on every turn. It can be mixed, and it can be a language outside the greeting.",
   "lineHeight": 1.25,
   "autoResize": true
  },
