   "isDeleted": false,
   "boundElements": [],
   "updated": 1759650000000,
   "link": null,
   "locked": false,
   "text": "LLM NOTEBOOK or LOG\nEverything decided, pressed or said is\nlogged, in order, so the model has context.\nNeeds the best system prompt to handle\nclashes and all.",
   "fontSize": 20,
   "fontFamily": 1,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "n_log",
   "originalText": "LLM NOTEBOOK or LOG\nEverything decided, pressed or said is logged, in order, so the model has context. Needs the best system prompt to handle clashes and all.",
   "lineHeight": 1.25,
   "autoResize": true
  },
