   "seed": 2120395275,
   "version": 1,
   "versionNonce": 253207297,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1759650000000,
   "link": null,
   "locked": false,
   "text": "HOW PEOPLE REALLY TALK (plan 1.3 and\n1.8)\n- \"no no, just tell me the scheme\": stop\nasking, show the 2 best, say what the pick\nis based on\n- \"I do not know\" / \"I will not say\": never\nasked again\n- \"I am NOT a farmer\": the word \"not\" is\nread\n- \"for my mother\": the questions are about\nher\n- a short name (\"PM Kisan\", \"MNREGA\") is a\nscheme name\n- a scheme we do not hold: \"I do not have\nthat one yet\"\n- two needs at once: one, then the other\n- \"the second one\", \"any other?\": from a list\nthe code keeps\n- \"will I get it?\": no promise; who it is for,\nthen the ONE thing not known\n- \"did not understand\": simpler words, not\nthe same ones\n- \"one minute\": waits up to 2 min\n- is it free, are you a person: true fixed\nlines\n- distress: one kind sentence FIRST, never\na list of questions\n- never takes an Aadhaar, bank or OTP\nnumber",
   "fontSize": 20,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "n_people",
   "originalText": "HOW PEOPLE REALLY TALK (plan 1.3 and 1.8)\n- \"no no, just tell me the scheme\": stop asking, show the 2 best, say what the pick is based on\n- \"I do not know\" / \"I will not say\": never asked again\n- \"I am NOT a farmer\": the word \"not\" is read\n- \"for my mother\": the questions are about her\n- a short name (\"PM Kisan\", \"MNREGA\") is a scheme name\n- a scheme we do not hold: \"I do not have that one yet\"\n- two needs at once: one, then the other\n- \"the second one\", \"any other?\": from a list the code keeps\n- \"will I get it?\": no promise; who it is for, then the ONE thing not known\n- \"did not understand\": simpler words, not the same ones\n- \"one minute\": waits up to 2 min\n- is it free, are you a person: true fixed lines\n- distress: one kind sentence FIRST, never a list of questions\n- never takes an Aadhaar, bank or OTP number",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
