   "updated": 1759650000000,
   "link": null,
   "locked": false,
   "text": "RAG SYSTEM\n- top 5 chunks\n- vector search, always in English\n- chunks cut by part: summary, benefits,\nhow to apply, details. Not by size, not at\nrandom.\n- more than one query for one need, then\nranking, to get the best chunks\n- plain name search too, for safety",
   "fontSize": 20,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "n_rag",
   "originalText": "RAG SYSTEM\n- top 5 chunks\n- vector search, always in English\n- chunks cut by part: summary, benefits, how to apply, details. Not by size, not at random.\n- more than one query for one need, then ranking, to get the best chunks\n- plain name search too, for safety",
   "lineHeight": 1.25,
   "autoResize": true
  },
