  {
   "id": "t_limits",
   "type": "text",
   "x": 628.0,
   "y": 2423.0,
   "width": 377.8,
   "height": 500.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1368426742,
   "version": 1,
   "versionNonce": 538981927,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1759650000000,
   "link": null,
   "locked": false,
   "text": "RULES AND LIMITS\n- a situation or a loose remark: ask\nfirst, one question at a time, at most 3,\nthen show schemes\n- a named scheme or a straight\nquestion: answer first\n- at most 2 searches in one turn\n- 3 clarifying questions in a row with\nno usable reply: \"Press 6 to use keys\"\n- 2 quiet waits in a row: goodbye\n- nothing ready 1.6 s after the caller\nstops: says \"one moment\"\n- 40 turns or 10 minutes: a polite\ngoodbye\n- \"just tell me\" always wins over a\nquestion\n- off topic 3 times in a row: a polite\ngoodbye\n- \"thanks\" is not goodbye: \"anything\nelse?\" once",
   "fontSize": 20,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "n_limits",
   "originalText": "RULES AND LIMITS\n- a situation or a loose remark: ask first, one question at a time, at most 3, then show schemes\n- a named scheme or a straight question: answer first\n- at most 2 searches in one turn\n- 3 clarifying questions in a row with no usable reply: \"Press 6 to use keys\"\n- 2 quiet waits in a row: goodbye\n- nothing ready 1.6 s after the caller stops: says \"one moment\"\n- 40 turns or 10 minutes: a polite goodbye\n- \"just tell me\" always wins over a question\n- off topic 3 times in a row: a polite goodbye\n- \"thanks\" is not goodbye: \"anything else?\" once",
   "lineHeight": 1.25,
   "autoResize": true
  },
