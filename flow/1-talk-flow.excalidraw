  {
   "id": "t_people",
   "type": "text",
   "x": 2088.0,
   "y": 1619.0,
   "width": 423.2,
   "height": 725.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
