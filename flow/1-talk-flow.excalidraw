   "link": null,
   "locked": false,
   "text": "TRUTH CHECK, before anything is said\nEvery number and name must be in the\nscheme text. Short sentences. No\npromise like \"you will get it\". Failed\ntwice: says \"I am not sure about that\".",
   "fontSize": 20,
   "fontFamily": 1,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "n_truth",
   "originalText": "TRUTH CHECK, before anything is said\nEvery number and name must be in the scheme text. Short sentences. No promise like \"you will get it\". Failed twice: says \"I am not sure about that\".",
   "lineHeight": 1.25,
   "autoResize": true
  },
